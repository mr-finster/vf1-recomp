/* The in-game menu. Sizes are in dp: the host sets 1dp = 1/720 of the window's height.
   Gradients are the vertex-colour kind (horizontal-gradient): the SDL renderer has no shaders.

   One column with a fixed space for each part, so nothing overlaps whatever the page:
     top 26 + title 56 + crumb 30 + rows 14 x 32 = 448 + note 8 + 84 (4 lines) + hint 6 + 22
     + version 2 + 18 = 700dp of 720: the longest page (a player's keys, 14 rows) fits without
     scrolling at any window size (1dp follows the window's height). Longer pages would scroll
     inside the rows; a long value is cut, never drawn over its label. */

body {
	width: 100%;
	height: 100%;
	font-family: "Barlow Condensed";
	font-weight: 600;
	font-size: 24dp;
	color: #dfe7fb;
}

div { display: block; }

#shade {
	position: absolute;
	left: 0; top: 0; right: 0; bottom: 0;
	decorator: horizontal-gradient(#040818f2 #04081850);
}

#panel {
	position: absolute;
	left: 9%;
	top: 26dp;
	width: 540dp;
}

#title {
	font-size: 48dp;
	font-weight: bold;
	font-style: italic;
	color: #ffd23f;
	height: 50dp;
	line-height: 50dp;
	padding-bottom: 3dp;
	border-bottom: 3dp #ffd23f;
}

#crumb {
	height: 26dp;
	line-height: 26dp;
	margin-bottom: 4dp;
	font-size: 19dp;
	font-weight: 500;
	color: #8fa3d6;
	white-space: nowrap;
	overflow: hidden;
}

#rows {
	max-height: 448dp;      /* 14 rows; longer pages scroll, keeping the selected row in view */
	overflow-y: hidden;
}

.row {
	display: flex;
	height: 30dp;
	line-height: 30dp;
	padding: 0 16dp;
	margin-bottom: 2dp;
	font-size: 23dp;
	color: #c3cff0;
	white-space: nowrap;
	transition: padding-left 0.12s cubic-out;
}

.row .label {
	flex: 1 0 auto;
	margin-right: 18dp;
}

.row .value {
	flex: 0 1 auto;
	overflow: hidden;
	color: #ffd23f;
	text-align: right;
}

.row.selected {
	decorator: horizontal-gradient(#ffd23f #ff8f1f);
	color: #0b1430;
	padding-left: 28dp;
}

.row.selected .value { color: #0b1430; }

.row .arrow { color: #8fa3d6; }
.row.selected .arrow { color: #0b1430; }

.row.info {
	height: 26dp;
	line-height: 26dp;
	font-size: 19dp;
	font-weight: 500;
	margin-bottom: 0;
}

.row.info .value { color: #dfe7fb; }

/* a row belonging to the one above it (a player's seed, their secret character) */
.row.sub { padding-left: 40dp; font-size: 21dp; }
.row.sub .label { color: #9fb0dc; }
.row.sub.selected { padding-left: 52dp; }
.row.sub.selected .label { color: #0b1430; }

/* a line under its row: a mistake to put right (red: a character seed no fighter has), or how it's going (green:
   online play's) */
.row.error, .row.good {
	height: auto;
	line-height: 24dp;
	padding-left: 52dp;
	font-size: 18dp;
	color: #ff6b5a;
	white-space: normal;   /* (a long one, a failed join's what to do, wraps) */
}
.row.error .label, .row.good .label { flex: 1 1 auto; margin-right: 0; }
.row.good { color: #7ee08a; }

/* a big value to read out (a host's address) */
.row.big {
	height: 44dp;
	line-height: 44dp;
	font-size: 34dp;
	font-style: italic;
	font-weight: 700;
	color: #ffd23f;
}

/* a section's title: small capitals over a rule, a gap above it (not the first) */
.row.heading {
	height: 24dp;
	line-height: 24dp;
	margin-top: 10dp;
	margin-bottom: 4dp;
	font-size: 16dp;
	font-weight: 700;
	letter-spacing: 2dp;
	color: #8fa3d6;
	border-bottom: 1dp #3a4a78;
}
.row.heading:first-child { margin-top: 0; }

#note {
	margin-top: 8dp;
	height: 84dp;           /* four lines; the help texts are written to fit */
	line-height: 21dp;
	overflow: hidden;
	font-size: 18dp;
	font-weight: 500;
	color: #8fa3d6;
}

#hint {
	margin-top: 6dp;
	height: 22dp;
	line-height: 22dp;
	font-size: 17dp;
	font-weight: 500;
	color: #8fa3d6;
	white-space: nowrap;
}

.key { color: #dfe7fb; }

/* the version and date, small, under the hint */
#ver {
	margin-top: 2dp;
	height: 18dp;
	line-height: 18dp;
	font-size: 15dp;
	font-weight: 500;
	color: #5f6f9c;
	white-space: nowrap;
}
