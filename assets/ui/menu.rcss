/* The in-game menu. Sizes are in dp: the host sets 1dp = 1/720 of the window's height (or 1/1280 of its width,
   if that's less: the panel is laid out for 720dp of height or more).
   Gradients are the vertex-colour kind (horizontal-gradient): the SDL renderer has no shaders.

   One column with a fixed space for each part, so nothing overlaps whatever the page:
     top 21.3 + title 46 + crumb 24.6 + rows 19 x 26.2 = 498 + note 6.6 + 68.9 (4 lines) + hint 4.9
     + 18 + version 1.6 + 14.8 = 705dp of 720. Every page fits whole, so none scrolls (a scroll can't be
     seen: the rows below looked missing); the longest, Display on Windows, has 18 and Back. menutest fails
     a page that doesn't fit. A long value is cut, never drawn over its label.
   (Each size 0.82 of what it was up to v1.6.0, when 14 rows fit: the same look, a size smaller, for
   Display's 19.) */

body {
	width: 100%;
	height: 100%;
	font-family: "Barlow Condensed";
	font-weight: 600;
	font-size: 19.7dp;
	color: #dfe7fb;
}

div { display: block; }

#shade {
	position: absolute;
	left: 0; top: 0; right: 0; bottom: 0;
	decorator: horizontal-gradient(#040818f2 #04081850);
}

#panel {
	position: absolute;
	left: 9%;
	top: 21.3dp;
	width: 442.8dp;
}

#title {
	font-size: 39.4dp;
	font-weight: bold;
	font-style: italic;
	color: #ffd23f;
	height: 41dp;
	line-height: 41dp;
	padding-bottom: 2.5dp;
	border-bottom: 2.5dp #ffd23f;
}

#crumb {
	height: 21.3dp;
	line-height: 21.3dp;
	margin-bottom: 3.3dp;
	font-size: 15.6dp;
	font-weight: 500;
	color: #8fa3d6;
	white-space: nowrap;
	overflow: hidden;
}

#rows {
	max-height: 498dp;      /* 19 rows; a longer page would scroll, keeping the selected row in view */
	overflow-y: hidden;
}

.row {
	display: flex;
	height: 24.6dp;
	line-height: 24.6dp;
	padding: 0 13.1dp;
	margin-bottom: 1.6dp;
	font-size: 18.9dp;
	color: #c3cff0;
	white-space: nowrap;
	transition: padding-left 0.12s cubic-out;
}

.row .label {
	flex: 1 0 auto;
	margin-right: 14.8dp;
}

.row .value {
	flex: 0 1 auto;
	overflow: hidden;
	color: #ffd23f;
	text-align: right;
}

.row.selected {
	decorator: horizontal-gradient(#ffd23f #ff8f1f);
	color: #0b1430;
	padding-left: 23dp;
}

.row.selected .value { color: #0b1430; }

.row .arrow { color: #8fa3d6; }
.row.selected .arrow { color: #0b1430; }

.row.info {
	height: 21.3dp;
	line-height: 21.3dp;
	font-size: 15.6dp;
	font-weight: 500;
	margin-bottom: 0;
}

.row.info .value { color: #dfe7fb; }

/* a row belonging to the one above it (a player's seed, their secret character) */
.row.sub { padding-left: 32.8dp; font-size: 17.2dp; }
.row.sub .label { color: #9fb0dc; }
.row.sub.selected { padding-left: 42.6dp; }
.row.sub.selected .label { color: #0b1430; }

/* a line under its row: a mistake to put right (red: a character seed no fighter has), or how it's going (green:
   online play's) */
.row.error, .row.good {
	height: auto;
	line-height: 19.7dp;
	padding-left: 42.6dp;
	font-size: 14.8dp;
	color: #ff6b5a;
	white-space: normal;   /* (a long one, a failed join's what to do, wraps) */
}
.row.error .label, .row.good .label { flex: 1 1 auto; margin-right: 0; }
.row.good { color: #7ee08a; }

/* a big value to read out (a host's address) */
.row.big {
	height: 36.1dp;
	line-height: 36.1dp;
	font-size: 27.9dp;
	font-style: italic;
	font-weight: 700;
	color: #ffd23f;
}

/* a section's title: small capitals over a rule, a gap above it (not the first) */
.row.heading {
	height: 19.7dp;
	line-height: 19.7dp;
	margin-top: 8.2dp;
	margin-bottom: 3.3dp;
	font-size: 13.1dp;
	font-weight: 700;
	letter-spacing: 1.6dp;
	color: #8fa3d6;
	border-bottom: 0.8dp #3a4a78;
}
.row.heading:first-child { margin-top: 0; }

#note {
	margin-top: 6.6dp;
	height: 68.9dp;           /* four lines; the help texts are written to fit */
	line-height: 17.2dp;
	overflow: hidden;
	font-size: 14.8dp;
	font-weight: 500;
	color: #8fa3d6;
}

#hint {
	margin-top: 4.9dp;
	height: 18dp;
	line-height: 18dp;
	font-size: 13.9dp;
	font-weight: 500;
	color: #8fa3d6;
	white-space: nowrap;
}

.key { color: #dfe7fb; }

/* the version and date, small, under the hint */
#ver {
	margin-top: 1.6dp;
	height: 14.8dp;
	line-height: 14.8dp;
	font-size: 12.3dp;
	font-weight: 500;
	color: #5f6f9c;
	white-space: nowrap;
}
